{
  "env": "production",
  "database": {
    "url": "${DATABASE_URL}"
  },
  "redis": {
    "url": "${REDIS_URL}"
  },
  "logging": {
    "enableSlowQueryLogging": false
  },
  "worker": {
    "concurrency": 50,
    "syncConcurrency": 20,
    "webhookRetryConcurrency": 10,
    "accountingRetryConcurrency": 5,
    "accountingTokenRefreshConcurrency": 3,
    "providerBalanceAlertConcurrency": 1
  }
}
